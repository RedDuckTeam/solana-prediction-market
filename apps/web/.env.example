# Which cluster the app talks to: localnet, devnet, or mainnet-beta.
# Defaults to devnet, so this file is optional.
VITE_CLUSTER=devnet

# The RPC endpoint does NOT go here. Anything named VITE_* is compiled into the
# bundle and readable by everyone. It lives in `.dev.vars` (see the example
# beside it), which both `dev` and `preview` read, and in a Cloudflare secret
# when deployed.
